# DATABASE_URL Neon (pooled). Jangan commit file .env asli.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/dbname?sslmode=require
# VAPID keys for Web Push (generate with: npx web-push generate-vapid-keys)
# Add BOTH to Vercel Environment Variables (Production + Preview + Development)
VAPID_PRIVATE_KEY=your_private_key_here
VAPID_PUBLIC_KEY=your_public_key_here
# Local cron testing secret (optional)
CRON_SECRET=dev-cron-secret-123
